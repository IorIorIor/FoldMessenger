<?xml version="1.0" encoding="utf-8"?>
<!--
  Message-card background: deep navy body with a blue glow along both side
  edges and a purple glow at the top, matching the supplied design.

  To use the designer's exact artwork instead, drop the PNG in as
  res/drawable-nodpi/bg_card.png and delete this file — every reference
  is by name (@drawable/bg_card), so nothing else needs to change.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- body -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#150A2F" />
            <corners android:radius="@dimen/card_corner_radius" />
        </shape>
    </item>

    <!-- blue glow on the left and right edges -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#2B47EC"
                android:centerColor="#00150A2F"
                android:endColor="#2340DC"
                android:type="linear" />
            <corners android:radius="@dimen/card_corner_radius" />
        </shape>
    </item>

    <!-- purple glow at the top -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.0"
                android:gradientRadius="70%p"
                android:startColor="#804C2BB4"
                android:endColor="#00150A2F"
                android:type="radial" />
            <corners android:radius="@dimen/card_corner_radius" />
        </shape>
    </item>
</layer-list>
