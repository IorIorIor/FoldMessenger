<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Viewer: background → centred message card → teaser/idle overlays -->
    <FrameLayout
        android:id="@+id/viewer_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Live WebGL background (assets/heart-view.html), driven by FxBackground.
             Inside viewer_group so it isn't rendering during first-run setup. -->
        <WebView
            android:id="@+id/fx_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <!-- The message card. Width/height wrap the content, so the box grows
             with the message; max sizes are applied in MainActivity. -->
        <LinearLayout
            android:id="@+id/card_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- media (image or video) with the byline overlaid at the bottom -->
            <FrameLayout
                android:id="@+id/media_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone">

                <!-- media_block is given its exact size in code (sizeMediaBlock),
                     so these can safely fill it -->
                <ImageView
                    android:id="@+id/media_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />

                <TextureView
                    android:id="@+id/media_video"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- message text: the whole card for a text-only secret, or a caption
                 under the media when both were sent -->
            <TextView
                android:id="@+id/card_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:breakStrategy="simple"
                android:fontFamily="@font/samsung_sharp_sans_bold"
                android:hyphenationFrequency="none"
                android:lineSpacingMultiplier="1.15"
                android:paddingHorizontal="@dimen/card_padding"
                android:paddingTop="@dimen/card_padding"
                android:textColor="@android:color/white"
                android:textSize="@dimen/card_text_size"
                android:visibility="gone" />

            <!-- byline for the text card (media cards use the overlaid one above) -->
            
        </LinearLayout>

        <!-- Closing question. A ScrollView with fillViewport so the block sits
             centred when it fits and scrolls when it doesn't; the three parts
             are separated by one shared gap, so the spacing reads as even. -->
        <ScrollView
            android:id="@+id/final_group"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingHorizontal="@dimen/card_padding"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/final_padding_v">

                <TextView
                    android:id="@+id/final_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:breakStrategy="simple"
                    android:fontFamily="@font/samsung_sharp_sans_bold"
                    android:gravity="center"
                    android:hyphenationFrequency="none"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/final_question_size" />

                <GridLayout
                    android:id="@+id/vote_grid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/final_gap"
                    android:columnCount="3" />

                <Button
                    android:id="@+id/btn_done"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/final_gap"
                    android:background="@drawable/btn_done"
                    android:fontFamily="@font/samsung_sharp_sans_bold"
                    android:paddingHorizontal="@dimen/done_button_padding_h"
                    android:paddingVertical="@dimen/done_button_padding_v"
                    android:text="@string/done_button"
                    android:textColor="#111111"
                    android:textSize="@dimen/done_button_size" />

                <!-- after KLAAR: the one they picked, held large for the reveal -->
                <LinearLayout
                    android:id="@+id/chosen_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/chosen_avatar"
                        android:layout_width="@dimen/chosen_avatar_size"
                        android:layout_height="@dimen/chosen_avatar_size"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/chosen_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/final_gap"
                        android:fontFamily="@font/apris_black"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/chosen_name_size" />
                </LinearLayout>

                <TextView
                    android:id="@+id/final_thanks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/samsung_sharp_sans_bold"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/final_question_size"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <!-- Selfie round: the phone's own camera app takes the picture -->
        <LinearLayout
            android:id="@+id/selfie_group"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/card_padding"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/selfie_ask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/samsung_sharp_sans_bold"
                    android:gravity="center"
                    android:text="@string/selfie_prompt"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/final_question_size" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/samsung_sharp_sans_bold"
                    android:gravity="center"
                    android:text="@string/selfie_hint"
                    android:textColor="#B0FFFFFF"
                    android:textSize="@dimen/vote_name_size" />

                <Button
                    android:id="@+id/btn_selfie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/final_gap"
                    android:background="@drawable/btn_done"
                    android:fontFamily="@font/samsung_sharp_sans_bold"
                    android:paddingHorizontal="@dimen/done_button_padding_h"
                    android:paddingVertical="@dimen/done_button_padding_v"
                    android:text="@string/selfie_button"
                    android:textColor="#111111"
                    android:textSize="@dimen/done_button_size" />
            </LinearLayout>

            <!-- their own shot, then straight back to idle -->
            <LinearLayout
                android:id="@+id/selfie_done"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/selfie_photo"
                    android:layout_width="@dimen/selfie_photo_size"
                    android:layout_height="@dimen/selfie_photo_size"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/final_gap"
                    android:fontFamily="@font/samsung_sharp_sans_bold"
                    android:gravity="center"
                    android:text="@string/selfie_sent"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/final_question_size" />
            </LinearLayout>
        </LinearLayout>

        <!-- "New Secret!" teaser on the cover screen -->
        <TextView
            android:id="@+id/cover_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/samsung_sharp_sans_bold"
            android:gravity="center"
            android:text="@string/cover_title"
            android:textColor="@android:color/white"
            android:textSize="@dimen/cover_title_size"
            android:visibility="gone" />

        <!-- allocated phone number, tucked into the bottom-left of the idle screen -->
        <TextView
            android:id="@+id/idle_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="@dimen/idle_label_margin"
            android:layout_marginBottom="@dimen/idle_label_margin"
            android:alpha="0.6"
            android:fontFamily="@font/samsung_sharp_sans_bold"
            android:textColor="@android:color/white"
            android:textSize="@dimen/idle_label_size"
            android:visibility="gone" />
    </FrameLayout>

    <!-- First-run setup -->
    <LinearLayout
        android:id="@+id/setup_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/setup_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/setup_title"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- filled in from Config.PHONE_COUNT by MainActivity.bindSetupButtons() -->
        <GridLayout
            android:id="@+id/phone_grid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="2" />
    </LinearLayout>
</FrameLayout>
